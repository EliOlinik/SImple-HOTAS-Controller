<Window x:Class="HotasController.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HOTAS Controller" Height="480" Width="840" MinWidth="800" MinHeight="340">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Fill" Value="#C0392B"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter Property="Fill" Value="#27AE60"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUnplugged}" Value="True">
                    <Setter Property="Fill" Value="#95A5A6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWorking}" Value="True">
                    <Setter Property="Fill" Value="#F1C40F"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="ReEnableAllButton" DockPanel.Dock="Right" Content="Re-enable all" Padding="14,4" Margin="8,0,0,0"
                        Command="{Binding ReEnableAllCommand}"
                        Visibility="{Binding HasDisabledControllers, Converter={StaticResource BoolToVisibility}}"/>
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Padding="14,4"
                        Command="{Binding RefreshCommand}"/>
                <TextBlock Text="Game controllers" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="PresetCombo" Width="200" Margin="0,0,10,0"
                          ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPresetName, Mode=TwoWay}"/>
                <Button x:Name="ApplyPresetButton" Content="Apply" Padding="14,4" Margin="0,0,6,0" Command="{Binding ApplyPresetCommand}"/>
                <Button x:Name="CreatePresetButton" Content="Create" Padding="14,4" Margin="0,0,6,0" Command="{Binding CreatePresetCommand}"/>
                <Button x:Name="UpdatePresetButton" Content="Update" Padding="14,4" Margin="0,0,6,0" Command="{Binding UpdatePresetCommand}"/>
                <Button x:Name="DeletePresetButton" Content="Delete" Padding="14,4" Command="{Binding DeletePresetCommand}"/>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="{Binding PresetSummary}" Foreground="Gray" Margin="0,0,0,8" TextWrapping="Wrap"
                       Visibility="{Binding HasPresetSummary, Converter={StaticResource BoolToVisibility}}"/>
            <Grid Grid.Row="3">
                <ListView x:Name="ControllerList" ItemsSource="{Binding Controllers}">
                    <ListView.Resources>
                        <!-- Greys out the text of rows for controllers that are not plugged in. -->
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnplugged}" Value="True">
                                    <Setter Property="Foreground" Value="Gray"/>
                                </DataTrigger>
                                <!-- Rows that Apply would switch are shown in bold. -->
                                <DataTrigger Binding="{Binding IsPlannedChange}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="On" Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanInteract}"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Name" Width="230" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="VID:PID" Width="80" DisplayMemberBinding="{Binding VidPid}"/>
                            <GridViewColumn Header="Nodes" Width="50" DisplayMemberBinding="{Binding NodeCountText}"/>
                            <GridViewColumn Header="" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Forget" Padding="10,1" Command="{Binding ForgetCommand}"
                                                ToolTip="Remove this controller from the selected preset"
                                                Visibility="{Binding IsUnplugged, Converter={StaticResource BoolToVisibility}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Status" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource StatusDot}"/>
                                            <TextBlock Text="{Binding StatusText}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="After apply" Width="150" DisplayMemberBinding="{Binding PlannedText}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="EmptyState" Text="No game controllers found. Plug one in and press Refresh."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasControllers}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
