<Window x:Class="HotasController.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HOTAS Controller" Height="420" Width="680" MinWidth="520" MinHeight="300">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Fill" Value="#C0392B"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter Property="Fill" Value="#27AE60"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWorking}" Value="True">
                    <Setter Property="Fill" Value="#F1C40F"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="ReEnableAllButton" DockPanel.Dock="Right" Content="Re-enable all" Padding="14,4" Margin="8,0,0,0"
                        Command="{Binding ReEnableAllCommand}"
                        Visibility="{Binding HasDisabledControllers, Converter={StaticResource BoolToVisibility}}"/>
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Padding="14,4"
                        Command="{Binding RefreshCommand}"/>
                <TextBlock Text="Game controllers" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid Grid.Row="1">
                <ListView x:Name="ControllerList" ItemsSource="{Binding Controllers}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="260" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="VID:PID" Width="80" DisplayMemberBinding="{Binding VidPid}"/>
                            <GridViewColumn Header="Nodes" Width="50" DisplayMemberBinding="{Binding NodeCount}"/>
                            <GridViewColumn Header="Status" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource StatusDot}"/>
                                            <TextBlock Text="{Binding StatusText}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ToggleButtonText}" Padding="10,2" MinWidth="70"
                                                Command="{Binding ToggleCommand}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="EmptyState" Text="No game controllers found. Plug one in and press Refresh."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasControllers}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
