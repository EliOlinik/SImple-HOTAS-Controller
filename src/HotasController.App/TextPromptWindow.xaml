<Window x:Class="HotasController.App.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HOTAS Controller" SizeToContent="Height" Width="380" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock x:Name="MessageText" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBox x:Name="InputBox" MaxLength="60" Padding="4,3"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" IsDefault="True" Width="76" Padding="0,3" Margin="0,0,8,0" Click="OnOk"/>
            <Button Content="Cancel" IsCancel="True" Width="76" Padding="0,3"/>
        </StackPanel>
    </StackPanel>
</Window>
